<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Performance Predictor | ML Project</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <!-- NAV -->
  <nav class="glass">
    <h2>StudentPredictor</h2>
    <a href="https://github.com/khushichillal-maker/Student-Performance-Predictor" target="_blank">GitHub Repo</a>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="glass hero-content">
      <h1>Predict Student Math Scores</h1>
      <p>Using Machine Learning + Data Science on real student data</p>
      <a href="#demo" class="btn">Try Live Demo ↓</a>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="glass section">
    <h2>About The Project</h2>
    <p>This ML model predicts student math scores based on study time, absences, health, family support and 30+ features. 
    Built with Python, Scikit-learn, Pandas, and trained on the UCI Student Performance Dataset.</p>
    <div class="stats">
      <div><h3>3</h3><p>Notebooks</p></div>
      <div><h3>90%+</h3><p>Accuracy</p></div>
      <div><h3>650</h3><p>Students Data</p></div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how" class="section">
    <h2>How It Works</h2>
    <div class="cards">
      <div class="glass card"><h3>1. EDA</h3><p>Explored data, found key correlations</p></div>
      <div class="glass card"><h3>2. Feature Eng</h3><p>Created new features + encoding</p></div>
      <div class="glass card"><h3>3. Model</h3><p>Trained RandomForest + tuned it</p></div>
    </div>
  </section>

  <!-- DEMO -->
  <section id="demo" class="glass section">
    <h2>Live Demo</h2>
    <p>Enter student details and get predicted math score</p>
    <form id="predictForm">
      <input type="number" id="studytime" placeholder="Study Time 1-4" min="1" max="4" required>
      <input type="number" id="absences" placeholder="Absences 0-93" min="0" max="93" required>
      <input type="number" id="health" placeholder="Health 1-5" min="1" max="5" required>
      <button type="submit" class="btn">Predict Score</button>
    </form>
    <h3 id="result"></h3>
  </section>

  <!-- FOOTER -->
  <footer>
    <p>Made by Khushi | <a href="https://github.com/khushichillal-maker/Student-Performance-Predictor">View Code</a></p>
  </footer>

  <script src="script.js"></script>
</body>
</html>
