* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }

body {
  background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
  color: #fff;
  background-attachment: fixed;
}

.glass {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(15px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
}

nav {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20px 10%; position: fixed; width: 100%; top: 0; z-index: 100;
}
nav a { color: #fff; text-decoration: none; border: 1px solid #fff; padding: 8px 16px; border-radius: 10px; }

.hero { height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; }
.hero-content { padding: 60px 40px; }
.hero h1 { font-size: 3rem; background: linear-gradient(90deg, #a18cd1, #fbc2eb); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.btn { display: inline-block; margin-top: 20px; padding: 12px 24px; background: linear-gradient(90deg, #a18cd1, #fbc2eb); color: #000; border-radius: 10px; text-decoration: none; border: none; cursor: pointer; font-weight: bold; }

.section { padding: 80px 10%; text-align: center; margin: 40px; }
.stats { display: flex; justify-content: space-around; margin-top: 30px; }
.cards { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin-top: 30px; }
.card { padding: 30px; width: 250px; }

input { padding: 12px; margin: 10px; border-radius: 10px; border: none; background: rgba(255,255,255,0.1); color: #fff; width: 200px; }
#result { margin-top: 20px; color: #fbc2eb; }
footer { text-align: center; padding: 30px; }
